<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootShell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageView
        android:id="@+id/remoteBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.34"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/future_main_background_3d" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/sideNavigation"
            android:layout_width="0dp"
            android:layout_weight="0.10"
            android:layout_height="match_parent"
            android:background="#D90D1732"
            android:elevation="12dp"
            android:clipChildren="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="12dp"
            android:paddingEnd="6dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/appLogo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                android:src="@drawable/future_logo_safe"
                android:visibility="gone" />

            <TextView
                android:id="@+id/brandMark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="FUTURE"
                android:textColor="@color/cyan"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/brandSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TV PLAYER"
                android:textColor="@color/text_muted"
                android:textSize="7sp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/navScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:scrollbars="vertical">
                <LinearLayout
                    android:id="@+id/navItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical" />
            </ScrollView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/channelColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:background="#C20D1120"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/liveHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/liveHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="◉  Live TV"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/liveMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_alt"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="1080P   EPG"
                    android:textColor="@color/text_secondary"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/channelHeadingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Olá, usuário"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/channelHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CANAIS AO VIVO"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/importProgressBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/activation_input_background"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/importProgressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏳ 0%  •  Seu conteúdo está sendo carregado. Já já você terá o melhor conteúdo!"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <ProgressBar
                    android:id="@+id/importProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="5dp"
                    android:max="100"
                    android:progress="0" />
            </LinearLayout>

            <TextView
                android:id="@+id/searchHint"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="10dp"
                android:background="@drawable/activation_input_background"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="Buscar canal..."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="7dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/categoryList"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/sortRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="Ordenar:"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/sortRecentButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="RECENTES"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/sortAlphaButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="A-Z"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/sortRatingButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="⭐ NOTA"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/channelList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/channelListLoadingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="⏳ Carregando essa categoria..."
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/vodSection"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/vodTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CATEGORIA DE FILMES (VOD)"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="5dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/vodCards"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/previewScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.48"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/previewContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/videoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:background="@drawable/tv_banner"
                    android:clipChildren="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.86"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:background="#070B15" />

                    <ImageView
                        android:id="@+id/previewLogo"
                        android:layout_width="240dp"
                        android:layout_height="132dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66080B16" />

                    <ImageView
                        android:id="@+id/tvFrameOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tv_frame_overlay"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/videoPreviewText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:padding="16dp"
                        android:text="Selecione um canal"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/liveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@color/magenta"
                        android:paddingStart="8dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="5dp"
                        android:text="AO VIVO"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/previewScaleButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:gravity="center"
                        android:minWidth="92dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="ESTICAR"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/channelDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <TextView
                        android:id="@+id/detailEyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailChannelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailTags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/nowCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/activation_input_background"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/nowLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="NOW PLAYING"
                            android:textColor="@color/magenta"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/currentProgram"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/currentProgramDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="17sp" />

                        <LinearLayout
                            android:id="@+id/epgUpcoming"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/programTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/text_muted"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nextProgram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/actionRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:id="@+id/detailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />

                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="140dp"
        android:background="#07102B"
        android:visibility="gone">

        <ImageView
            android:id="@+id/homeBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="1.0"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/future_home_clean_for_native_sidebar" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <com.futuretv.player.OrbitLinesView
            android:id="@+id/orbitLines"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

                <FrameLayout
            android:id="@+id/homeUserHeader"
            android:layout_width="320dp"
            android:layout_height="104dp"
            android:layout_gravity="top|start"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false">
            <ImageView
                android:id="@+id/homeProfileImage"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="2dp"
                android:scaleType="fitCenter"
                android:contentDescription="Trocar perfil" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="52dp"
                android:layout_marginTop="0dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeClockText"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/homeDateText"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/homeUserName"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="0dp"
                android:layout_marginTop="44dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="FUTURE USER"
                android:textColor="#DCE9FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/homeOnlineBadge"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="78dp"
            android:background="#3D24366B"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="●  CONECTADO"
            android:textColor="#9FFFE5"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/homeNavSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="22dp"
            android:background="@drawable/activation_input_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⌕"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/homeOrbitRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
